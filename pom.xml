<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.example</groupId>
    <artifactId>modular-monolith</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>modular-monolith</name>
    <description>Production-ready Spring Boot modular monolith template: DDD bounded contexts, Spring Modulith boundaries, OAuth2 Resource Server (JWT), event-driven module communication.</description>

    <properties>
        <java.version>21</java.version>
        <spring-modulith.version>2.1.0</spring-modulith.version>
        <!-- Boot 4.1.0 BOM pins Flyway 12.4.0, whose PostgreSQL support window predates
             PG 16.14/17.10 (FlywayException: Unsupported Database). Newest 12.x line. -->
        <flyway.version>12.11.0</flyway.version>
        <!-- springdoc 3.x is the Spring Boot 4 / Framework 7 line; 3.1.0 targets Boot 4.1.0.
             Do NOT downgrade to the 2.x line (Boot 3 only). -->
        <springdoc.version>3.1.0</springdoc.version>
        <!-- Resilience4j 2.4.0 is the first release with a dedicated Spring Boot 4 starter
             (resilience4j-spring-boot4); the rate-limit/throttle filters use the core
             RateLimiter API, the starter brings the auto-configuration. -->
        <resilience4j.version>2.4.0</resilience4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Modulith is not part of the Boot BOM; import its own BOM. -->
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Web / API layer -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Bean Validation (API DTOs) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Spring Data JPA / Hibernate (persistence implementation detail) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!-- Redis: distributed rate limiting (security module, fixed-window counters)
             and the read cache (Spring Cache abstraction). Lettuce client. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>

        <!-- Security: OAuth2 Resource Server with JWT bearer tokens -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- AOP for Resilience4j annotation support (aspects; @RateLimiter/@Retry/... on
             future outbound integrations). Boot 4 renamed the AOP starter to
             spring-boot-starter-aspectj. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>
        <!-- Resilience4j 2.4.0: Spring Boot 4 starter. The rate-limit/throttle filters in the
             security module use the core RateLimiter API (per-IP instances from a registry);
             the starter's auto-configuration and health integration are ready for the first
             outbound fault-tolerance usage (see docs/security.md "Resilience4j"). -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-spring-boot4</artifactId>
            <version>${resilience4j.version}</version>
        </dependency>

        <!-- Database migrations -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <!-- Flyway database plugin: PostgreSQL support lives in a separate artifact
             since Flyway 10+ (discovered via ServiceLoader at runtime). -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Observability: Actuator + Micrometer, Prometheus-ready.
             Boot 4 split Micrometer metrics support into its own module
             (spring-boot-micrometer-metrics); without it the prometheus
             endpoint is never registered. The registry implementation
             (micrometer-registry-prometheus) is still required. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-micrometer-metrics</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- Distributed tracing: Micrometer Tracing bridge + OpenTelemetry OTLP exporter.
             Boot 4 splits the tracing auto-configuration into its own module
             (spring-boot-micrometer-tracing-opentelemetry); without it no spans are
             created and trace IDs never reach the MDC. Spans populate the MDC
             (trace.id/span.id) for log correlation even without a collector;
             see docs/observability.md. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <!-- JDBC query spans (datasource-micrometer, by the Micrometer maintainers):
             proxies the DataSource and emits OTel semantic-convention spans for query
             execution (db.system/db.operation/sanitized db.statement) through the
             existing ObservationRegistry + tracing bridge. The spring-boot module
             auto-instruments the DataSource bean; the opentelemetry module maps
             observations to OTel conventions. See docs/observability.md "SQL spans". -->
        <dependency>
            <groupId>net.ttddyy.observation</groupId>
            <artifactId>datasource-micrometer-spring-boot</artifactId>
            <version>2.2.1</version>
        </dependency>
        <dependency>
            <groupId>net.ttddyy.observation</groupId>
            <artifactId>datasource-micrometer-opentelemetry</artifactId>
            <version>2.2.1</version>
        </dependency>

        <!-- PostgreSQL driver (runtime only) -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Spring Modulith: application module detection, architecture verification,
             and in-process transactional events (@ApplicationModuleListener).
             events-api alone provides the annotation; events-core is intentionally
             NOT included: its auto-configurations (event publication registry,
             staleness monitor, externalization) require a durable repository and
             belong to Stage 2 (see docs/event-driven.md). -->
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-events-api</artifactId>
        </dependency>

        <!-- API documentation: OpenAPI spec + Swagger UI (springdoc 3.x = Boot 4 line) -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Dev: automatic restart on code changes -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers: real PostgreSQL for integration tests (version managed by Boot BOM) -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Boot 4's test infrastructure (spring-boot-micrometer-metrics-test, pulled in
                 by spring-boot-starter-actuator-test) disables metrics export in every
                 @SpringBootTest by default. Re-enable it so /actuator/prometheus and the
                 business counters are exercised by the integration tests. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <spring.test.metrics.export>true</spring.test.metrics.export>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <!-- Generates git.properties (git.commit.id, git.build.time) into the runtime
                 classpath for the /actuator/info GitInfoContributor. Bound to the
                 initialize phase; failOnNoGitDirectory=false keeps non-git checkouts
                 buildable (the info section is simply absent there). -->
            <plugin>
                <groupId>io.github.git-commit-id</groupId>
                <artifactId>git-commit-id-maven-plugin</artifactId>
                <version>9.0.2</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>revision</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <failOnNoGitDirectory>false</failOnNoGitDirectory>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
